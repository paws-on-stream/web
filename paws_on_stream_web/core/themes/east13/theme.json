{
  "schema_version": 3,
  "theme": {
    "id": "east13",
    "name": "EAST 13",
    "version": "3.0.0",
    "description": "Lossless migration of the EAST Pygame theme",
    "reference_renderer": "pygame"
  },
  "compatibility": {
    "minimum_renderer_version": "1.0.0",
    "supported_renderers": ["pygame", "web-preview"],
    "legacy_schema_version": 2
  },
  "display_profile": {
    "id": "broadcast-1080p50",
    "width": 1920,
    "height": 1080,
    "refresh_rate": 50,
    "color_mode": "RGBA",
    "transparent_output": true
  },
  "assets": {
    "chat_top": {
      "type": "image",
      "file": "chat-top.png",
      "format": "png",
      "required": true,
      "width": 640,
      "height": 60,
      "alpha": true,
      "sha256": "c9630d4c096a74c832fb1d663d83e75e6584db3e786e593e6b80f8cdb89149d8"
    },
    "chat_middle": {
      "type": "image",
      "file": "chat-middle.png",
      "format": "png",
      "required": true,
      "width": 640,
      "height": 40,
      "alpha": true,
      "sha256": "d0f7d2ea59f9a642987b4645addba7a9791ecc0080df74a59e8fa609dbfae7c2"
    },
    "chat_bottom": {
      "type": "image",
      "file": "chat-bottom.png",
      "format": "png",
      "required": true,
      "width": 640,
      "height": 66,
      "alpha": true,
      "sha256": "70738d632e41289e721bb56e85c69adecea8dbb1050b0d29ab4dec37cea827f7"
    }
  },
  "canvas": {
    "background_color": "#333333"
  },
  "fonts": {
    "default": {
      "provider": "pygame",
      "name": "freesansbold.ttf",
      "size": 24,
      "antialias": true
    }
  },
  "chat": {
    "position": {
      "x": 40,
      "y": 40,
      "negative_coordinates": "offset_from_opposite_edge"
    },
    "scale": 0.6,
    "max_width": 700,
    "max_visible_messages": 1,
    "gap_between_messages": 16,
    "background": {
      "color": "#a5f2fb",
      "frame": {
        "type": "segmented_vertical",
        "top": "chat_top",
        "middle": "chat_middle",
        "bottom": "chat_bottom",
        "top_render": {"horizontal": "smooth_scale", "vertical": "native"},
        "middle_render": {"horizontal": "smooth_scale", "vertical": "tile"},
        "bottom_render": {"horizontal": "smooth_scale", "vertical": "native"},
        "content_bottom_spacer": {"type": "asset_height", "asset": "chat_bottom"}
      },
      "padding": {"x": 45, "y": 0}
    },
    "template": {
      "direction": "vertical",
      "elements": [
        {"field": "display_name", "style": "name", "margin_bottom": 4},
        {"field": "content", "style": "message", "margin_bottom": 10},
        {"field": "media", "style": "media", "margin_bottom": 0}
      ]
    },
    "styles": {
      "name": {
        "type": "text",
        "color": "#7c5cff",
        "font_size": 26,
        "bold": true,
        "italic": false,
        "alignment": "left",
        "wrap": false,
        "line_spacing": 4
      },
      "message": {
        "type": "text",
        "color": "#000000",
        "font_size": 24,
        "bold": false,
        "italic": false,
        "alignment": "left",
        "wrap": true,
        "line_spacing": 4
      },
      "media": {
        "type": "media",
        "alignment": "center",
        "max_width": 600,
        "max_height": 300,
        "fit": "contain",
        "allow_upscale": false,
        "preserve_aspect_ratio": true,
        "alpha_compositing": true
      }
    },
    "markup": {
      "bold": "*",
      "italic": "_",
      "code": "`",
      "strike": "~~"
    },
    "animation": {
      "timebase": "milliseconds",
      "fade_in_ms": 300,
      "hold": {"source": "display_settings.display_duration_sec"},
      "fade_out_ms": 300
    }
  },
  "ticker": {
    "position": {
      "x": 40,
      "y": -120,
      "negative_coordinates": "offset_from_opposite_edge"
    },
    "width": -80,
    "scale": 0.6,
    "background": {"type": "color", "color": "#1f2b3a"},
    "text": {
      "color": "#ffffff",
      "font_size": 24,
      "format": "{display_name}: {content}",
      "single_line": true
    },
    "padding": {"x": 45, "y": 8},
    "separator": "  •  ",
    "scroll": {
      "direction": "right_to_left",
      "speed": {
        "source": "display_settings.scroll_speed_px",
        "unit": "pixels_per_render_update"
      },
      "start_position": "panel_right"
    }
  },
  "media": {
    "accepted_formats": ["webp"],
    "accepted_types": ["photo", "gif", "sticker"],
    "static": true,
    "animated": true,
    "alpha": true,
    "preserve_frame_durations": true,
    "limits": {
      "maximum_file_size": 10485760,
      "maximum_width": 1280,
      "maximum_height": 1280,
      "maximum_frames": 150,
      "maximum_duration_ms": 10000
    }
  },
  "luma": {
    "mode": "opaque-content",
    "background_color": "#000000",
    "content_color": "#ffffff",
    "alpha_threshold": 1
  },
  "rendering": {
    "coordinate_space": {"width": 1920, "height": 1080},
    "positioning": {"clamp_to_screen": true},
    "scaling": {"filter": "smoothscale", "rounding": "nearest_integer"},
    "alpha_compositing": {"enabled": true, "mode": "source_over"}
  },
  "preview": {
    "web": {
      "enabled": true,
      "reference_width": 1920,
      "reference_height": 1080,
      "accuracy": "best_effort"
    }
  }
}
